  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "preserve", "jsxImportSource": "@opentui/solid", "strict": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "noEmit": true, "types": ["bun"]
